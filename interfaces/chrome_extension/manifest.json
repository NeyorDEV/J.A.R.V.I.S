{
  "manifest_version": 3,
  "name": "JARVIS Web Controller",
  "version": "1.1",
  "description": "Contrôle vocal et curseur virtuel par le DOM pour JARVIS.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
