{
  "manifest_version": 3,
  "name": "JARVIS Web Controller",
  "version": "2.0",
  "description": "Relie J.A.R.V.I.S au navigateur : onglets, médias, lecture de page et actions sur les pages, protégés par un jeton.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "JARVIS Web Controller"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
